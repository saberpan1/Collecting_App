/**
 * 首页样式
 */
.container {
  padding: 0;
  background: linear-gradient(180deg, #8B4513 0%, #f5f5f5 300rpx);
}

/* 头部区域 */
.header {
  margin: 20rpx;
  background: linear-gradient(135deg, #8B4513 0%, #A0522D 100%);
  color: #fff;
}

.header-content {
  margin-bottom: 20rpx;
}

.welcome {
  font-size: 40rpx;
  font-weight: bold;
  display: block;
  margin-bottom: 8rpx;
}

.subtitle {
  font-size: 26rpx;
  opacity: 0.9;
}

.upload-btn {
  display: flex;
  align-items: center;
  justify-content: center;
  background-color: rgba(255, 255, 255, 0.2);
  padding: 16rpx 32rpx;
  border-radius: 8rpx;
  width: fit-content;
}

.upload-icon {
  font-size: 32rpx;
  font-weight: bold;
  margin-right: 8rpx;
}

/* 统计卡片 */
.stats-card {
  margin: 20rpx;
}

.stats-grid {
  display: grid;
  grid-template-columns: repeat(2, 1fr);
  gap: 20rpx;
  margin-top: 20rpx;
}

.stat-item {
  text-align: center;
  padding: 20rpx;
  background-color: #f9f9f9;
  border-radius: 12rpx;
}

.stat-number {
  font-size: 40rpx;
  font-weight: bold;
  color: #8B4513;
  display: block;
  margin-bottom: 8rpx;
}

.stat-label {
  font-size: 24rpx;
  color: #666;
}

/* 分类区域 */
.category-section {
  padding: 0 20rpx;
}

.section-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 20rpx;
}

.more-link {
  color: #8B4513;
  font-size: 26rpx;
}

.category-grid {
  display: grid;
  grid-template-columns: repeat(2, 1fr);
  gap: 20rpx;
}

.category-item {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 32rpx 20rpx;
}

.category-icon {
  font-size: 64rpx;
  margin-bottom: 12rpx;
}

.category-name {
  font-size: 28rpx;
  color: #333;
}

/* 最近收藏 */
.recent-section {
  padding: 0 20rpx;
}

.recent-list {
  display: flex;
  flex-direction: column;
  gap: 16rpx;
}

.recent-item {
  display: flex;
  padding: 16rpx;
}

.recent-image {
  width: 120rpx;
  height: 120rpx;
  border-radius: 8rpx;
  margin-right: 16rpx;
  background-color: #f0f0f0;
}

.recent-info {
  flex: 1;
  display: flex;
  flex-direction: column;
  justify-content: center;
}

.recent-name {
  font-size: 28rpx;
  font-weight: bold;
  color: #333;
  margin-bottom: 8rpx;
}

.recent-date {
  font-size: 24rpx;
  color: #999;
}
