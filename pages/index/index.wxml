<!--首页 - 设计系统 v3.0-->
<view class="page">
  <!-- 导航栏 -->
  <view class="navbar">
    <view class="navbar-left"></view>
    <text class="navbar-title">古钱币收藏</text>
    <view class="navbar-right"></view>
  </view>

  <!-- 内容区域 -->
  <scroll-view scroll-y class="content">
    <!-- Hero 区域 -->
    <view class="hero card fade-in">
      <view class="hero-content">
        <view class="hero-text">
          <text class="hero-title">我的收藏</text>
          <text class="hero-subtitle">记录每一枚钱币的故事</text>
        </view>
        <view class="hero-progress">
          <view class="progress-ring">
            <view class="progress-ring-inner">
              <text class="progress-value">{{stats.completionRate}}%</text>
            </view>
          </view>
        </view>
      </view>

      <!-- 统计行 -->
      <view class="hero-stats">
        <view class="stat-item">
          <text class="stat-value">{{stats.collectedVariants}}</text>
          <text class="stat-label">已收藏</text>
        </view>
        <view class="stat-divider"></view>
        <view class="stat-item">
          <text class="stat-value">{{stats.totalVariants}}</text>
          <text class="stat-label">总版别</text>
        </view>
        <view class="stat-divider"></view>
        <view class="stat-item">
          <text class="stat-value">{{stats.totalImages}}</text>
          <text class="stat-label">图片</text>
        </view>
      </view>
    </view>

    <!-- 快速操作 -->
    <view class="quick-actions fade-in">
      <view class="action-btn primary" bindtap="goToUpload">
        <view class="action-icon-wrap">
          <text class="action-icon">+</text>
        </view>
        <view class="action-text-wrap">
          <text class="action-title">上传藏品</text>
          <text class="action-desc">记录新的收藏</text>
        </view>
      </view>
      <view class="action-btn secondary" bindtap="goToCategory">
        <view class="action-icon-wrap">
          <text class="action-icon">▤</text>
        </view>
        <view class="action-text-wrap">
          <text class="action-title">浏览分类</text>
          <text class="action-desc">探索更多版别</text>
        </view>
      </view>
    </view>

    <!-- 分类浏览 -->
    <view class="section fade-in">
      <view class="section-header">
        <text class="section-title">分类浏览</text>
        <view class="more-btn" bindtap="goToCategory">
          <text>查看全部</text>
          <text class="arrow">›</text>
        </view>
      </view>

      <view class="category-list card">
        <view
          class="category-item"
          wx:for="{{categories}}"
          wx:key="id"
          data-id="{{item.id}}"
          data-name="{{item.name}}"
          bindtap="goToDetail"
        >
          <view class="category-icon-wrap">
            <text class="category-icon">💰</text>
          </view>
          <view class="category-content">
            <text class="category-name">{{item.name}}</text>
            <text class="category-meta">{{item.eras.length}} 个年代</text>
          </view>
          <text class="category-arrow">›</text>
        </view>
      </view>
    </view>

    <!-- 最近收藏 -->
    <view class="section fade-in" wx:if="{{recentCollection.length > 0}}">
      <view class="section-header">
        <text class="section-title">最近收藏</text>
      </view>

      <view class="recent-list card">
        <view
          class="recent-item"
          wx:for="{{recentCollection}}"
          wx:key="id"
        >
          <image
            class="recent-image"
            src="{{item.images[0] || ''}}"
            mode="aspectFill"
          />
          <view class="recent-content">
            <text class="recent-name">{{item.name}}</text>
            <text class="recent-date">{{item.date}}</text>
          </view>
          <view class="recent-badge">
            <text>{{item.images.length}} 张</text>
          </view>
        </view>
      </view>
    </view>

    <!-- 空状态 -->
    <view class="empty-state" wx:if="{{recentCollection.length === 0 && stats.totalVariants === 0}}">
      <text class="empty-icon">💰</text>
      <text class="empty-title">开始你的收藏之旅</text>
      <text class="empty-text">上传第一枚古钱币，记录美好的收藏故事</text>
      <view class="empty-action" bindtap="goToUpload">
        <text>立即上传</text>
      </view>
    </view>

    <!-- 底部留白 -->
    <view class="bottom-space"></view>
  </scroll-view>

  <!-- 自定义TabBar -->
  <custom-tabbar list="{{tabbarList}}" selected="{{selectedTabBar}}" />
</view>
