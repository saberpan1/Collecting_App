/* 上传页面样式 */

/* 页面容器 */
.page-container {
  min-height: 100vh;
  background-color: #fafaf8;
  padding-bottom: env(safe-area-inset-bottom);
}

/* 导航栏 */
.nav-bar {
  display: flex;
  align-items: center;
  justify-content: space-between;
  height: 88rpx;
  padding: 0 24rpx;
  background-color: #ffffff;
  border-bottom: 1rpx solid #eeeeee;
}

.nav-back {
  width: 60rpx;
  height: 60rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}

.nav-back-icon {
  font-size: 48rpx;
  color: #1a1a1a;
  font-weight: 300;
}

.nav-title {
  font-size: 32rpx;
  font-weight: 600;
  color: #1a1a1a;
}

.nav-placeholder {
  width: 60rpx;
}

/* 步骤指示器 */
.steps-indicator {
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 40rpx 60rpx;
  background-color: #ffffff;
  margin-bottom: 24rpx;
}

.step-item {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 12rpx;
}

.step-circle {
  width: 56rpx;
  height: 56rpx;
  border-radius: 50%;
  background-color: #e5e5e5;
  display: flex;
  align-items: center;
  justify-content: center;
}

.step-item.active .step-circle {
  background-color: #1a1a1a;
}

.step-num {
  font-size: 24rpx;
  font-weight: 600;
  color: #ffffff;
}

.step-check {
  font-size: 24rpx;
  font-weight: 600;
  color: #ffffff;
}

.step-label {
  font-size: 22rpx;
  color: #999999;
}

.step-item.active .step-label {
  color: #1a1a1a;
}

.step-line {
  width: 80rpx;
  height: 2rpx;
  background-color: #e5e5e5;
  margin: 0 16rpx;
  margin-bottom: 40rpx;
}

.step-line.active {
  background-color: #1a1a1a;
}

/* 步骤内容 */
.step-content {
  padding: 0 24rpx;
  padding-bottom: 200rpx;
}

/* 区块 */
.section {
  margin-bottom: 32rpx;
}

.section-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 20rpx;
  padding: 0 8rpx;
}

.section-title {
  font-size: 32rpx;
  font-weight: 600;
  color: #1a1a1a;
}

/* 选择器卡片 */
.selector-card {
  background-color: #ffffff;
  border-radius: 24rpx;
  overflow: hidden;
}

.selector-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 24rpx;
  border-bottom: 1rpx solid #eeeeee;
  min-height: 100rpx;
  box-sizing: border-box;
}

.selector-row:last-child {
  border-bottom: none;
}

.selector-row:active {
  background-color: #fafafa;
}

.selector-row.disabled {
  opacity: 0.5;
}

.selector-left {
  display: flex;
  align-items: center;
  gap: 16rpx;
  flex: 1;
}

.selector-icon {
  width: 64rpx;
  height: 64rpx;
  border-radius: 16rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 24rpx;
  font-weight: 600;
}

.coin-icon {
  background-color: rgba(201, 169, 98, 0.1);
  color: #c9a962;
}

.era-icon {
  background-color: rgba(74, 144, 226, 0.1);
  color: #4a90e2;
}

.variant-icon {
  background-color: rgba(144, 190, 109, 0.1);
  color: #90be6d;
}

.selector-info {
  display: flex;
  flex-direction: column;
  gap: 4rpx;
}

.selector-label {
  font-size: 22rpx;
  color: #999999;
}

.selector-value {
  font-size: 28rpx;
  color: #1a1a1a;
}

.selector-value.placeholder {
  color: #cccccc;
}

.selector-arrow {
  font-size: 36rpx;
  color: #cccccc;
  font-weight: 300;
}

.selector-arrow.disabled {
  color: #e5e5e5;
}

.picker-control {
  display: flex;
  align-items: center;
  gap: 8rpx;
}

.picker-control.disabled {
  opacity: 0.5;
}

/* 底部操作 */
.bottom-action {
  position: fixed;
  bottom: 0;
  left: 0;
  right: 0;
  display: flex;
  flex-direction: row;
  gap: 20rpx;
  padding: 24rpx;
  padding-bottom: calc(24rpx + env(safe-area-inset-bottom));
  background-color: #ffffff;
  box-shadow: 0 -4rpx 20rpx rgba(0, 0, 0, 0.05);
}

.bottom-action .btn-secondary,
.bottom-action .btn-primary {
  flex: 1;
}

.action-hint {
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 8rpx;
  margin-bottom: 20rpx;
}

.hint-icon {
  font-size: 24rpx;
}

.hint-text {
  font-size: 24rpx;
  color: #999999;
}

.btn-primary {
  width: 100%;
  height: 96rpx;
  background-color: #e5e5e5;
  border-radius: 48rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 8rpx;
  font-size: 32rpx;
  font-weight: 600;
  color: #ffffff;
  transition: all 0.2s;
}

.btn-primary.ready {
  background-color: #1a1a1a;
}

.btn-primary:active {
  opacity: 0.8;
}

.btn-arrow {
  font-size: 32rpx;
}

.btn-secondary {
  width: 100%;
  height: 96rpx;
  background-color: #ffffff;
  border: 2rpx solid #e5e5e5;
  border-radius: 48rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 8rpx;
  font-size: 32rpx;
  font-weight: 600;
  color: #1a1a1a;
}

.btn-arrow-back {
  font-size: 32rpx;
}

/* 选中信息栏 */
.selected-info-bar {
  display: flex;
  align-items: center;
  gap: 12rpx;
  padding: 20rpx 24rpx;
  background-color: #ffffff;
  border-radius: 16rpx;
  margin-bottom: 24rpx;
}

.info-bar-icon {
  font-size: 28rpx;
}

.info-bar-text {
  flex: 1;
  font-size: 28rpx;
  color: #1a1a1a;
}

.info-bar-edit {
  font-size: 24rpx;
  color: #c9a962;
}

/* 图片计数器 */
.image-counter {
  font-size: 24rpx;
  color: #999999;
}

/* 图片类型选择器 */
.image-type-selector {
  display: flex;
  gap: 12rpx;
  margin: 0 24rpx;
  margin-bottom: 16rpx;
}

.type-btn {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 4rpx;
  padding: 16rpx;
  background-color: #ffffff;
  border-radius: 16rpx;
  border: 2rpx solid transparent;
}

.type-btn.active {
  background-color: #1a1a1a;
  color: #ffffff;
}

.type-icon {
  font-size: 26rpx;
  font-weight: 600;
}

.type-label {
  font-size: 22rpx;
}

/* 图片网格容器 */
.image-grid-container {
  padding: 0 24rpx;
}

.image-grid {
  display: grid;
  grid-template-columns: repeat(3, 1fr);
  gap: 16rpx;
}

.image-cell {
  position: relative;
  aspect-ratio: 1;
  border-radius: 16rpx;
  overflow: hidden;
}

.image-preview {
  width: 100%;
  height: 100%;
}

.image-type-badge {
  position: absolute;
  top: 8rpx;
  left: 8rpx;
  padding: 4rpx 12rpx;
  background-color: rgba(0, 0, 0, 0.6);
  border-radius: 8rpx;
}

.image-type-badge text {
  font-size: 18rpx;
  color: #ffffff;
}

.image-delete {
  position: absolute;
  top: 8rpx;
  right: 8rpx;
  width: 44rpx;
  height: 44rpx;
  background-color: rgba(0, 0, 0, 0.5);
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
}

.image-delete text {
  font-size: 28rpx;
  color: #ffffff;
  font-weight: 300;
}

.add-image-cell {
  aspect-ratio: 1;
  background-color: #ffffff;
  border-radius: 16rpx;
  border: 2rpx dashed #e5e5e5;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  gap: 8rpx;
}

.add-image-cell:active {
  background-color: #fafafa;
}

.add-icon-wrap {
  width: 64rpx;
  height: 64rpx;
  position: relative;
}

.add-icon-h {
  position: absolute;
  top: 50%;
  left: 0;
  width: 100%;
  height: 2rpx;
  background-color: #cccccc;
  transform: translateY(-50%);
}

.add-icon-v {
  position: absolute;
  left: 50%;
  top: 0;
  width: 2rpx;
  height: 100%;
  background-color: #cccccc;
  transform: translateX(-50%);
}

.add-label {
  font-size: 22rpx;
  color: #999999;
}

/* 上传提示 */
.upload-tips {
  padding: 16rpx 24rpx;
}

.tip-text {
  font-size: 22rpx;
  color: #999999;
}

/* 备注区块 */
.note-counter {
  font-size: 22rpx;
  color: #999999;
}

.note-card {
  background-color: #ffffff;
  border-radius: 24rpx;
  padding: 24rpx;
}

.note-textarea {
  width: 100%;
  height: 200rpx;
  font-size: 28rpx;
  color: #1a1a1a;
  line-height: 1.6;
}

.note-textarea::placeholder {
  color: #cccccc;
}

/* 价格区块 */
.price-card {
  background-color: #ffffff;
  border-radius: 24rpx;
  padding: 24rpx;
}

.price-input-wrap {
  display: flex;
  align-items: center;
  gap: 8rpx;
}

.price-symbol {
  font-size: 36rpx;
  color: #c9a962;
  font-weight: 600;
}

.price-input {
  flex: 1;
  height: 64rpx;
  font-size: 32rpx;
  color: #1a1a1a;
}

.price-input::placeholder {
  color: #cccccc;
}

.price-hint {
  display: block;
  margin-top: 12rpx;
  font-size: 22rpx;
  color: #999999;
}

/* 成功页面 */
.success-page {
  display: flex;
  align-items: center;
  justify-content: center;
  min-height: calc(100vh - 200rpx);
}

.success-container {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 60rpx 40rpx;
}

.success-icon-wrap {
  margin-bottom: 40rpx;
}

.success-circle {
  width: 120rpx;
  height: 120rpx;
  border-radius: 50%;
  background-color: #c9a962;
  display: flex;
  align-items: center;
  justify-content: center;
}

.success-check {
  font-size: 60rpx;
  color: #ffffff;
  font-weight: 300;
}

.success-title {
  font-size: 40rpx;
  font-weight: 600;
  color: #1a1a1a;
  margin-bottom: 16rpx;
}

.success-subtitle {
  font-size: 26rpx;
  color: #666666;
  margin-bottom: 48rpx;
}

.success-stats {
  display: flex;
  align-items: center;
  gap: 40rpx;
  padding: 32rpx 60rpx;
  background-color: #ffffff;
  border-radius: 24rpx;
  margin-bottom: 60rpx;
}

.stat-item {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 8rpx;
}

.stat-value {
  font-size: 40rpx;
  font-weight: 600;
  color: #1a1a1a;
}

.stat-label {
  font-size: 22rpx;
  color: #999999;
}

.stat-divider {
  width: 1rpx;
  height: 60rpx;
  background-color: #e5e5e5;
}

.success-actions {
  display: flex;
  flex-direction: column;
  gap: 20rpx;
  width: 100%;
}

.action-row {
  width: 100%;
}

/* 弹窗遮罩 */
.modal-mask {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background-color: rgba(0, 0, 0, 0.5);
  z-index: 900;
  opacity: 0;
  visibility: hidden;
  transition: opacity 0.3s, visibility 0.3s;
}

.modal-mask.show {
  opacity: 1;
  visibility: visible;
}

/* 弹窗容器 */
.modal-container {
  position: fixed;
  bottom: 0;
  left: 0;
  right: 0;
  background-color: #ffffff;
  border-radius: 32rpx 32rpx 0 0;
  z-index: 901;
  transform: translateY(100%);
  transition: transform 0.3s ease-out;
  max-height: 80vh;
  overflow-y: auto;
}

.modal-mask.show .modal-container {
  transform: translateY(0);
}

.modal-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 24rpx;
  border-bottom: 1rpx solid #eeeeee;
}

.modal-title {
  font-size: 28rpx;
  font-weight: 600;
  color: #1a1a1a;
}

.modal-close {
  width: 60rpx;
  height: 60rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}

.modal-close text {
  font-size: 32rpx;
  color: #999999;
  font-weight: 300;
}

.modal-body {
  padding: 32rpx 24rpx;
}

.form-group {
  margin-bottom: 32rpx;
}

.form-group:last-child {
  margin-bottom: 0;
}

.form-label {
  display: block;
  font-size: 26rpx;
  color: #666666;
  margin-bottom: 16rpx;
}

.form-input {
  width: 100%;
  height: 88rpx;
  background-color: #fafafa;
  border-radius: 16rpx;
  padding: 0 24rpx;
  font-size: 28rpx;
  color: #1a1a1a;
  box-sizing: border-box;
}

.form-input::placeholder {
  color: #cccccc;
}

.form-tips {
  margin-top: 16rpx;
  padding: 16rpx;
  background-color: #fafafa;
  border-radius: 12rpx;
}

.form-tips text {
  font-size: 22rpx;
  color: #999999;
}

.modal-footer {
  display: flex;
  gap: 20rpx;
  padding: 24rpx;
  border-top: 1rpx solid #eeeeee;
}

.btn-modal-cancel {
  flex: 1;
  height: 88rpx;
  background-color: #fafafa;
  border-radius: 44rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 28rpx;
  font-weight: 600;
  color: #666666;
}

.btn-modal-confirm {
  flex: 1;
  height: 88rpx;
  background-color: #e5e5e5;
  border-radius: 44rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 28rpx;
  font-weight: 600;
  color: #ffffff;
}

.btn-modal-confirm.ready {
  background-color: #c9a962;
}

/* 子版别网格 */
.sub-variant-grid {
  display: grid;
  grid-template-columns: repeat(3, 1fr);
  gap: 12rpx;
}

.sub-variant-chip {
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 16rpx;
  background-color: #fafaf8;
  border-radius: 16rpx;
  border: 2rpx solid transparent;
}

.sub-variant-chip.selected {
  background-color: rgba(201, 169, 98, 0.08);
  border-color: #c9a962;
  color: #c9a962;
}

.sub-variant-chip text {
  font-size: 24rpx;
  font-weight: 500;
}

/* 自定义选择器弹窗 */
.picker-modal {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  z-index: 1000;
  opacity: 0;
  visibility: hidden;
  transition: opacity 0.3s, visibility 0.3s;
}

.picker-modal.show {
  opacity: 1;
  visibility: visible;
}

.picker-mask {
  position: absolute;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background-color: rgba(0, 0, 0, 0.5);
}

.picker-container {
  position: absolute;
  bottom: 0;
  left: 0;
  right: 0;
  background-color: #ffffff;
  border-radius: 32rpx 32rpx 0 0;
  transform: translateY(100%);
  transition: transform 0.3s ease-out;
}

.picker-modal.show .picker-container {
  transform: translateY(0);
}

.picker-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 24rpx 32rpx;
  border-bottom: 1rpx solid #eeeeee;
}

.picker-cancel {
  font-size: 28rpx;
  color: #999999;
}

.picker-title {
  font-size: 28rpx;
  font-weight: 600;
  color: #1a1a1a;
}

.picker-confirm {
  font-size: 28rpx;
  color: #c9a962;
  font-weight: 600;
}

.picker-view {
  height: 400rpx;
}

.picker-item {
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 30rpx;
  color: #1a1a1a;
  padding: 20rpx 0;
}
