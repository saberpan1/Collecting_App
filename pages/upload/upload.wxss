/**
 * 上传页样式
 */

/* 页面容器 */
.page-container {
  min-height: 100vh;
  background-color: #fafaf8;
  display: flex;
  flex-direction: column;
}

/* 导航栏 */
.nav-bar {
  display: flex;
  align-items: center;
  justify-content: space-between;
  height: 88rpx;
  padding: 0 24rpx;
  background-color: #ffffff;
}

.nav-back {
  width: 80rpx;
  height: 60rpx;
  display: flex;
  align-items: center;
  justify-content: flex-start;
}

.nav-back-icon {
  font-size: 48rpx;
  color: #1a1a1a;
  font-weight: 300;
}

.nav-title {
  font-size: 28rpx;
  font-weight: 600;
  color: #1a1a1a;
}

.nav-placeholder {
  width: 80rpx;
}

/* 步骤指示器 */
.steps-indicator {
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 24rpx 32rpx;
  background-color: #ffffff;
}

.step-item {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 8rpx;
}

.step-circle {
  width: 48rpx;
  height: 48rpx;
  border-radius: 50%;
  background-color: #f5f5f3;
  border: 2rpx solid #e5e5e5;
  display: flex;
  align-items: center;
  justify-content: center;
}

.step-item.active .step-circle {
  background-color: #1a1a1a;
  border-color: #1a1a1a;
}

.step-num {
  font-size: 24rpx;
  font-weight: 600;
  color: #999999;
}

.step-item.active .step-num {
  color: #ffffff;
}

.step-check {
  font-size: 26rpx;
  color: #ffffff;
  font-weight: bold;
}

.step-label {
  font-size: 22rpx;
  color: #999999;
}

.step-item.active .step-label {
  color: #1a1a1a;
  font-weight: 500;
}

.step-line {
  width: 80rpx;
  height: 2rpx;
  background-color: #e5e5e5;
  margin: 0 12rpx;
  margin-bottom: 40rpx;
}

.step-line.active {
  background-color: #1a1a1a;
}

/* 步骤内容 */
.step-content {
  flex: 1;
  display: flex;
  flex-direction: column;
}

.success-page {
  justify-content: center;
}

/* 区块 */
.section {
  margin-bottom: 24rpx;
}

.section-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 0 24rpx;
  margin-bottom: 12rpx;
}

.section-title {
  font-size: 22rpx;
  font-weight: 600;
  color: #999999;
  text-transform: uppercase;
  letter-spacing: 1rpx;
}

/* 选择器卡片 */
.selector-card {
  margin: 0 24rpx;
  background-color: #ffffff;
  border-radius: 20rpx;
  overflow: hidden;
  box-shadow: 0 2rpx 8rpx rgba(0, 0, 0, 0.04), 0 4rpx 16rpx rgba(0, 0, 0, 0.06);
}

.selector-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 24rpx;
  border-bottom: 1rpx solid #eeeeee;
  min-height: 100rpx;
  box-sizing: border-box;
}

.selector-row:last-child {
  border-bottom: none;
}

.selector-row:active {
  background-color: #fafafa;
}

.selector-row.disabled {
  opacity: 0.5;
}

.selector-left {
  display: flex;
  align-items: center;
  gap: 16rpx;
  flex: 1;
}

.selector-icon {
  width: 64rpx;
  height: 64rpx;
  border-radius: 12rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 26rpx;
  font-weight: 600;
  flex-shrink: 0;
}

.coin-icon {
  background: linear-gradient(135deg, rgba(201, 169, 98, 0.08) 0%, rgba(201, 169, 98, 0.15) 100%);
  color: #c9a962;
}

.era-icon {
  background: linear-gradient(135deg, rgba(0, 122, 255, 0.08) 0%, rgba(0, 122, 255, 0.1) 100%);
  color: #007aff;
}

.variant-icon {
  background: linear-gradient(135deg, rgba(52, 199, 89, 0.08) 0%, rgba(52, 199, 89, 0.1) 100%);
  color: #34c759;
}

.sub-icon {
  background: linear-gradient(135deg, rgba(255, 149, 0, 0.08) 0%, rgba(255, 149, 0, 0.1) 100%);
  color: #ff9500;
}

.selector-info {
  display: flex;
  flex-direction: column;
  gap: 4rpx;
}

.selector-label {
  font-size: 24rpx;
  color: #999999;
  font-weight: 500;
}

.selector-value {
  font-size: 28rpx;
  color: #1a1a1a;
  font-weight: 500;
}

.selector-value.placeholder {
  color: #c7c7c7;
}

.selector-arrow {
  font-size: 36rpx;
  color: #e5e5e5;
  font-weight: 300;
}

.selector-arrow.disabled {
  color: #f5f5f3;
}

/* 新建版别入口 */
.create-variant-section {
  padding: 16rpx 24rpx;
}

.create-variant-btn {
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 12rpx;
  padding: 16rpx;
  background-color: #ffffff;
  border-radius: 16rpx;
  border: 2rpx dashed #e5e5e5;
}

.create-variant-btn:active {
  background-color: #fafafa;
}

.create-icon-wrap {
  width: 40rpx;
  height: 40rpx;
  border-radius: 50%;
  background-color: #1a1a1a;
  display: flex;
  align-items: center;
  justify-content: center;
}

.create-icon {
  font-size: 28rpx;
  color: #ffffff;
  font-weight: 300;
}

.create-text {
  font-size: 28rpx;
  color: #1a1a1a;
  font-weight: 500;
}

/* 底部操作区 */
.bottom-action {
  margin-top: auto;
  padding: 24rpx;
  padding-bottom: calc(24rpx + env(safe-area-inset-bottom));
  background-color: #ffffff;
  border-top: 1rpx solid #eeeeee;
}

.action-hint {
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 8rpx;
  margin-bottom: 16rpx;
}

.hint-text {
  font-size: 24rpx;
  color: #999999;
}

/* 按钮 */
.btn-primary {
  width: 100%;
  height: 96rpx;
  background-color: #f5f5f3;
  color: #999999;
  border-radius: 16rpx;
  font-size: 28rpx;
  font-weight: 600;
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 12rpx;
  border: none;
}

.btn-primary.ready {
  background-color: #1a1a1a;
  color: #ffffff;
}

.btn-primary:active {
  transform: scale(0.98);
}

.btn-secondary {
  flex: 1;
  height: 96rpx;
  background-color: #f5f5f3;
  color: #1a1a1a;
  border-radius: 16rpx;
  font-size: 28rpx;
  font-weight: 600;
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 8rpx;
  border: none;
}

.btn-secondary:active {
  background-color: #e8e8e5;
}

/* 已选版别信息条 */
.selected-info-bar {
  display: flex;
  align-items: center;
  gap: 12rpx;
  margin: 16rpx 24rpx;
  padding: 16rpx 24rpx;
  background-color: rgba(201, 169, 98, 0.08);
  border-radius: 16rpx;
}

.info-bar-icon {
  font-size: 28rpx;
}

.info-bar-text {
  flex: 1;
  font-size: 24rpx;
  color: #c9a962;
  font-weight: 500;
}

.info-bar-edit {
  padding: 8rpx 16rpx;
  background-color: #ffffff;
  border-radius: 8rpx;
}

.info-bar-edit text {
  font-size: 22rpx;
  color: #c9a962;
  font-weight: 500;
}

/* 图片计数器 */
.image-counter,
.note-counter {
  font-size: 22rpx;
  color: #999999;
  font-weight: 500;
}

/* 图片类型选择器 */
.image-type-selector {
  display: flex;
  gap: 12rpx;
  margin: 0 24rpx;
  margin-bottom: 16rpx;
}

.type-btn {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 4rpx;
  padding: 16rpx;
  background-color: #ffffff;
  border-radius: 16rpx;
  border: 2rpx solid transparent;
}

.type-btn.active {
  background-color: #1a1a1a;
  color: #ffffff;
}

.type-icon {
  font-size: 26rpx;
  font-weight: 600;
}

.type-label {
  font-size: 22rpx;
  opacity: 0.7;
}

/* 图片网格 */
.image-grid-container {
  margin: 0 24rpx;
}

.image-grid {
  display: grid;
  grid-template-columns: repeat(3, 1fr);
  gap: 12rpx;
}

.image-cell {
  position: relative;
  aspect-ratio: 1;
  border-radius: 16rpx;
  overflow: hidden;
  background-color: #f5f5f3;
}

.image-preview {
  width: 100%;
  height: 100%;
}

.image-type-badge {
  position: absolute;
  bottom: 8rpx;
  left: 8rpx;
  padding: 4rpx 10rpx;
  background-color: rgba(26, 26, 26, 0.85);
  border-radius: 8rpx;
}

.image-type-badge text {
  font-size: 18rpx;
  color: #ffffff;
  font-weight: 500;
}

.image-delete {
  position: absolute;
  top: 8rpx;
  right: 8rpx;
  width: 44rpx;
  height: 44rpx;
  background-color: rgba(255, 59, 48, 0.9);
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  opacity: 0;
}

.image-cell:active .image-delete {
  opacity: 1;
}

.image-delete text {
  font-size: 28rpx;
  color: #ffffff;
  font-weight: 300;
}

/* 添加图片按钮 */
.add-image-cell {
  aspect-ratio: 1;
  background-color: #ffffff;
  border-radius: 16rpx;
  border: 2rpx dashed #e5e5e5;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  gap: 8rpx;
}

.add-image-cell:active {
  background-color: #fafafa;
}

.add-icon-wrap {
  width: 56rpx;
  height: 56rpx;
  position: relative;
}

.add-icon-h,
.add-icon-v {
  position: absolute;
  background-color: #999999;
  border-radius: 2rpx;
  top: 50%;
  left: 50%;
}

.add-icon-h {
  width: 36rpx;
  height: 4rpx;
  transform: translate(-50%, -50%);
}

.add-icon-v {
  width: 4rpx;
  height: 36rpx;
  transform: translate(-50%, -50%);
}

.add-label {
  font-size: 22rpx;
  color: #999999;
}

/* 上传提示 */
.upload-tips {
  padding: 16rpx 24rpx;
}

.tip-text {
  font-size: 22rpx;
  color: #999999;
}

/* 备注卡片 */
.note-card {
  margin: 0 24rpx;
  background-color: #ffffff;
  border-radius: 20rpx;
  padding: 16rpx;
}

.note-textarea {
  width: 100%;
  min-height: 160rpx;
  padding: 16rpx;
  background-color: #fafaf8;
  border-radius: 16rpx;
  font-size: 28rpx;
  color: #1a1a1a;
  line-height: 1.6;
  resize: none;
  box-sizing: border-box;
}

.note-textarea::placeholder {
  color: #c7c7c7;
}

/* 完成页面 */
.success-container {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 80rpx 48rpx;
}

.success-icon-wrap {
  margin-bottom: 32rpx;
}

.success-circle {
  width: 160rpx;
  height: 160rpx;
  border-radius: 50%;
  background-color: #34c759;
  display: flex;
  align-items: center;
  justify-content: center;
}

.success-check {
  font-size: 80rpx;
  color: #ffffff;
  font-weight: bold;
}

.success-title {
  font-size: 44rpx;
  font-weight: bold;
  color: #1a1a1a;
  margin-bottom: 12rpx;
}

.success-subtitle {
  font-size: 28rpx;
  color: #999999;
  text-align: center;
  margin-bottom: 48rpx;
}

.success-stats {
  display: flex;
  align-items: center;
  gap: 48rpx;
  padding: 24rpx 48rpx;
  background-color: #ffffff;
  border-radius: 20rpx;
  margin-bottom: 48rpx;
}

.stat-item {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 4rpx;
}

.stat-value {
  font-size: 36rpx;
  font-weight: bold;
  color: #1a1a1a;
}

.stat-label {
  font-size: 22rpx;
  color: #999999;
}

.stat-divider {
  width: 1rpx;
  height: 60rpx;
  background-color: #eeeeee;
}

.success-actions {
  display: flex;
  gap: 16rpx;
  width: 100%;
}

.success-actions .btn-primary {
  flex: 1;
}

.success-actions .btn-secondary {
  flex: 1;
}

/* 弹窗 */
.modal-mask {
  position: fixed;
  inset: 0;
  background-color: rgba(0, 0, 0, 0);
  z-index: 1000;
  pointer-events: none;
}

.modal-mask.show {
  background-color: rgba(0, 0, 0, 0.5);
  pointer-events: auto;
}

.modal-container {
  position: absolute;
  bottom: 0;
  left: 0;
  right: 0;
  background-color: #ffffff;
  border-radius: 24rpx 24rpx 0 0;
  max-height: 85vh;
  transform: translateY(100%);
  overflow: hidden;
}

.modal-mask.show .modal-container {
  transform: translateY(0);
}

.modal-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 24rpx;
  border-bottom: 1rpx solid #eeeeee;
}

.modal-title {
  font-size: 28rpx;
  font-weight: 600;
  color: #1a1a1a;
}

.modal-close {
  width: 60rpx;
  height: 60rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}

.modal-close text {
  font-size: 32rpx;
  color: #999999;
  font-weight: 300;
}

.modal-body {
  padding: 24rpx;
  max-height: 60vh;
  overflow-y: auto;
}

.modal-footer {
  display: flex;
  gap: 16rpx;
  padding: 24rpx;
  padding-bottom: calc(24rpx + env(safe-area-inset-bottom));
  border-top: 1rpx solid #eeeeee;
}

/* 表单 */
.form-group {
  margin-bottom: 24rpx;
}

.form-label {
  display: block;
  font-size: 24rpx;
  color: #999999;
  margin-bottom: 12rpx;
  font-weight: 500;
}

.form-input {
  width: 100%;
  height: 96rpx;
  padding: 0 16rpx;
  background-color: #fafaf8;
  border-radius: 16rpx;
  font-size: 28rpx;
  color: #1a1a1a;
  box-sizing: border-box;
}

.form-input::placeholder {
  color: #c7c7c7;
}

.form-tips {
  padding: 8rpx 0;
}

.form-tips text {
  font-size: 22rpx;
  color: #999999;
}

/* 子版别网格 */
.sub-variant-grid {
  display: grid;
  grid-template-columns: repeat(3, 1fr);
  gap: 12rpx;
}

.sub-variant-chip {
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 16rpx;
  background-color: #fafaf8;
  border-radius: 16rpx;
  border: 2rpx solid transparent;
}

.sub-variant-chip.selected {
  background-color: rgba(201, 169, 98, 0.08);
  border-color: #c9a962;
  color: #c9a962;
}

.sub-variant-chip text {
  font-size: 24rpx;
  font-weight: 500;
}

/* 弹窗按钮 */
.btn-modal-cancel,
.btn-modal-confirm {
  flex: 1;
  height: 96rpx;
  border-radius: 16rpx;
  font-size: 28rpx;
  font-weight: 600;
  border: none;
}

.btn-modal-cancel {
  background-color: #f5f5f3;
  color: #1a1a1a;
}

.btn-modal-confirm {
  background-color: #f5f5f3;
  color: #999999;
}

.btn-modal-confirm.ready {
  background-color: #1a1a1a;
  color: #ffffff;
}

/* 入手价格卡片 */
.price-card {
  margin: 0 24rpx;
  background-color: #ffffff;
  border-radius: 20rpx;
  padding: 24rpx;
}

.price-input-wrap {
  display: flex;
  align-items: center;
  gap: 12rpx;
}

.price-symbol {
  font-size: 36rpx;
  font-weight: 600;
  color: #c9a962;
}

.price-input {
  flex: 1;
  height: 80rpx;
  font-size: 32rpx;
  color: #1a1a1a;
  font-weight: 500;
}

.price-input::placeholder {
  color: #c7c7c7;
}

.price-hint {
  display: block;
  margin-top: 12rpx;
  font-size: 22rpx;
  color: #999999;
}