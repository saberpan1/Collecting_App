/**
 * 上传页面样式
 */
.page-title {
  font-size: 36rpx;
  font-weight: bold;
  margin-bottom: 20rpx;
}

/* 版别信息 */
.variant-info {
  margin-bottom: 20rpx;
}

.variant-label {
  font-size: 26rpx;
  color: #999;
  display: block;
  margin-bottom: 8rpx;
}

.variant-name {
  font-size: 32rpx;
  font-weight: bold;
  color: #8B4513;
}

/* 类型选择器 */
.type-selector {
  margin-bottom: 20rpx;
}

.type-options {
  display: flex;
  gap: 16rpx;
  margin-top: 16rpx;
}

.type-option {
  flex: 1;
  text-align: center;
  padding: 20rpx;
  background-color: #f0f0f0;
  border-radius: 8rpx;
  font-size: 28rpx;
  color: #666;
}

.type-option.active {
  background-color: #8B4513;
  color: #fff;
}

/* 上传区域 */
.upload-section {
  margin-bottom: 20rpx;
}

.image-grid {
  display: grid;
  grid-template-columns: repeat(3, 1fr);
  gap: 16rpx;
  margin-top: 16rpx;
}

.image-item {
  position: relative;
  aspect-ratio: 1;
  border-radius: 8rpx;
  overflow: hidden;
  background-color: #f0f0f0;
}

.image-preview {
  width: 100%;
  height: 100%;
}

.image-type-tag {
  position: absolute;
  top: 8rpx;
  left: 8rpx;
  background-color: rgba(139, 69, 19, 0.9);
  color: #fff;
  padding: 4rpx 12rpx;
  border-radius: 4rpx;
  font-size: 22rpx;
}

.delete-btn {
  position: absolute;
  top: 8rpx;
  right: 8rpx;
  width: 48rpx;
  height: 48rpx;
  background-color: rgba(255, 0, 0, 0.8);
  color: #fff;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 32rpx;
}

/* 添加图片按钮 */
.add-image-btn {
  aspect-ratio: 1;
  background-color: #f9f9f9;
  border: 2rpx dashed #ccc;
  border-radius: 8rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
}

.add-icon {
  font-size: 48rpx;
  color: #999;
  margin-bottom: 8rpx;
}

.add-text {
  font-size: 24rpx;
  color: #999;
}

/* 备注输入 */
.note-section {
  margin-bottom: 20rpx;
}

.note-input {
  width: 100%;
  min-height: 160rpx;
  padding: 16rpx;
  background-color: #f9f9f9;
  border-radius: 8rpx;
  font-size: 28rpx;
  margin-top: 12rpx;
}

/* 操作区域 */
.action-section {
  padding: 40rpx 20rpx;
}

.save-btn {
  background-color: #8B4513;
  color: #fff;
  border-radius: 8rpx;
  padding: 24rpx;
  font-size: 32rpx;
  font-weight: bold;
}

.save-btn[disabled] {
  background-color: #ccc;
}
