/**
 * 分类页样式 - 性能优化+用户体验优化
 */

/* ========================================
   页面结构
   ======================================== */

.page {
  min-height: 100vh;
  background-color: var(--color-paper-warm);
  display: flex;
  flex-direction: column;
}

.navbar {
  flex-shrink: 0;
}

.content {
  flex: 1;
  padding-bottom: var(--space-4xl);
}

/* ========================================
   导航栏
   ======================================== */

.navbar-left,
.navbar-right {
  width: 120rpx;
}

.navbar-back {
  display: flex;
  align-items: center;
  padding: var(--space-xs) var(--space-sm);
  border-radius: var(--radius-sm);
  transition: background-color var(--duration-fast) var(--ease-out);
}

.navbar-back:active {
  background-color: var(--color-paper-dark);
}

.back-icon {
  font-size: 40rpx;
  color: var(--color-ink);
}

/* ========================================
   引导提示
   ======================================== */

.guide-tip {
  display: flex;
  align-items: center;
  justify-content: center;
  padding: var(--space-md);
  margin: var(--space-md) var(--space-lg) 0;
}

.guide-icon {
  font-size: var(--font-size-body);
  margin-right: var(--space-sm);
}

.guide-text {
  font-size: var(--font-size-body-sm);
  color: var(--color-muted);
}

/* ========================================
   分类列表
   ======================================== */

.category-list {
  margin: var(--space-md) var(--space-lg);
}

.category-item {
  display: flex;
  align-items: center;
  padding: var(--space-lg);
  background-color: var(--color-paper);
  border-bottom: 1rpx solid var(--color-divider);
  transition: background-color var(--duration-fast) var(--ease-out);
}

.category-item:first-child {
  border-radius: var(--radius-xl) var(--radius-xl) 0 0;
}

.category-item:last-child {
  border-bottom: none;
  border-radius: 0 0 var(--radius-xl) var(--radius-xl);
}

.item-hover {
  background-color: var(--color-paper-dark) !important;
}

.category-icon-wrap {
  width: 88rpx;
  height: 88rpx;
  border-radius: var(--radius-lg);
  background: linear-gradient(135deg, var(--color-bronze-bg) 0%, var(--color-paper-dark) 100%);
  display: flex;
  align-items: center;
  justify-content: center;
  margin-right: var(--space-md);
}

.category-icon {
  font-size: 40rpx;
}

.category-content {
  flex: 1;
  min-width: 0;
}

.category-name {
  display: block;
  font-size: var(--font-size-body);
  font-weight: var(--font-weight-semibold);
  color: var(--color-ink);
  margin-bottom: var(--space-xxs);
}

.category-meta {
  display: block;
  font-size: var(--font-size-caption);
  color: var(--color-muted);
}

.category-arrow {
  font-size: var(--font-size-h3);
  color: var(--color-border);
  font-weight: 300;
}

/* ========================================
   统计概览
   ======================================== */

.stats-overview {
  margin: var(--space-lg);
  padding: var(--space-lg);
}

.stats-row {
  display: flex;
  justify-content: space-around;
  align-items: center;
}

.stat-box {
  text-align: center;
  flex: 1;
}

.stat-value {
  display: block;
  font-size: var(--font-size-h2);
  font-weight: var(--font-weight-bold);
  color: var(--color-ink);
  letter-spacing: var(--letter-spacing-tight);
  margin-bottom: var(--space-xxs);
}

.stat-label {
  display: block;
  font-size: var(--font-size-caption);
  color: var(--color-muted);
}

.stat-divider {
  width: 1rpx;
  height: 60rpx;
  background-color: var(--color-divider);
}

/* ========================================
   面包屑导航
   ======================================== */

.breadcrumb {
  display: flex;
  align-items: center;
  padding: var(--space-md) var(--space-lg);
  overflow-x: auto;
  white-space: nowrap;
}

.breadcrumb::-webkit-scrollbar {
  display: none;
}

.breadcrumb-item {
  font-size: var(--font-size-body-sm);
  color: var(--color-muted);
  transition: color var(--duration-fast) var(--ease-out);
}

.breadcrumb-item:active {
  color: var(--color-ink);
}

.breadcrumb-sep {
  font-size: var(--font-size-body-sm);
  color: var(--color-border);
  margin: 0 var(--space-sm);
}

.breadcrumb-current {
  font-size: var(--font-size-body-sm);
  color: var(--color-ink);
  font-weight: var(--font-weight-medium);
}

/* ========================================
   年代列表
   ======================================== */

.era-list {
  margin: 0 var(--space-lg);
}

.era-item {
  display: flex;
  align-items: center;
  padding: var(--space-lg);
  background-color: var(--color-paper);
  border-bottom: 1rpx solid var(--color-divider);
  transition: background-color var(--duration-fast) var(--ease-out);
}

.era-item:first-child {
  border-radius: var(--radius-xl) var(--radius-xl) 0 0;
}

.era-item:last-child {
  border-bottom: none;
  border-radius: 0 0 var(--radius-xl) var(--radius-xl);
}

.era-content {
  flex: 1;
  min-width: 0;
}

.era-name {
  display: block;
  font-size: var(--font-size-body);
  font-weight: var(--font-weight-semibold);
  color: var(--color-ink);
  margin-bottom: var(--space-xxs);
}

.era-years {
  display: block;
  font-size: var(--font-size-caption);
  color: var(--color-muted);
}

.era-badge {
  padding: var(--space-xxs) var(--space-sm);
  background-color: var(--color-bronze-bg);
  border-radius: var(--radius-xs);
  font-size: var(--font-size-caption);
  color: var(--color-bronze);
  margin-right: var(--space-md);
}

.era-arrow {
  font-size: var(--font-size-h3);
  color: var(--color-border);
  font-weight: 300;
}

/* ========================================
   筛选栏
   ======================================== */

.filter-bar {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: var(--space-md) var(--space-lg);
  margin-bottom: var(--space-sm);
}

.filter-group {
  display: flex;
  gap: var(--space-xs);
}

.filter-btn {
  padding: var(--space-sm) var(--space-md);
  background-color: var(--color-paper);
  border-radius: var(--radius-md);
  font-size: var(--font-size-body-sm);
  color: var(--color-muted);
  transition: all var(--duration-fast) var(--ease-out);
}

.filter-btn.active {
  background-color: var(--color-ink);
  color: var(--color-paper);
}

.filter-count {
  font-size: var(--font-size-caption);
  color: var(--color-muted);
}

/* ========================================
   版别卡片
   ======================================== */

.variant-list {
  padding: 0 var(--space-lg);
}

.variant-card {
  margin-bottom: var(--space-md);
  padding: 0;
}

.variant-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: var(--space-lg);
  border-bottom: 1rpx solid var(--color-divider);
}

.variant-name {
  font-size: var(--font-size-body);
  font-weight: var(--font-weight-semibold);
  color: var(--color-ink);
}

.variant-status {
  padding: var(--space-xxs) var(--space-sm);
  background-color: var(--color-paper-dark);
  border-radius: var(--radius-xs);
  font-size: var(--font-size-caption);
  color: var(--color-muted);
}

.variant-status.collected {
  background-color: var(--color-bronze-bg);
  color: var(--color-bronze);
}

/* ========================================
   子版别列表
   ======================================== */

.sub-variants {
  padding: 0;
}

.sub-variant-item {
  display: flex;
  flex-direction: column;
  padding: var(--space-md) var(--space-lg);
  border-bottom: 1rpx solid var(--color-divider);
  transition: background-color var(--duration-fast) var(--ease-out);
}

.sub-variant-item:last-child {
  border-bottom: none;
}

.sub-variant-info {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: var(--space-sm);
}

.sub-variant-name {
  font-size: var(--font-size-body-sm);
  color: var(--color-ink);
  flex: 1;
}

.sub-variant-badges {
  display: flex;
  gap: var(--space-xs);
}

.badge {
  padding: var(--space-xxs) var(--space-sm);
  border-radius: var(--radius-xs);
  font-size: var(--font-size-caption);
}

.badge-default {
  background-color: var(--color-paper-dark);
  color: var(--color-muted);
}

.badge-success {
  background-color: var(--color-bronze-bg);
  color: var(--color-bronze);
}

.badge-count {
  background-color: var(--color-paper-dark);
  color: var(--color-muted);
}

.sub-variant-actions {
  display: flex;
  gap: var(--space-sm);
}

.action-btn {
  flex: 1;
  padding: var(--space-sm) var(--space-md);
  border-radius: var(--radius-sm);
  font-size: var(--font-size-caption);
  text-align: center;
  transition: all var(--duration-fast) var(--ease-out);
}

.action-btn.primary {
  background-color: var(--color-ink);
  color: var(--color-paper);
}

.action-btn.primary:active {
  opacity: 0.8;
}

.action-btn.secondary {
  background-color: var(--color-paper-dark);
  color: var(--color-ink);
}

.action-btn.secondary:active {
  background-color: var(--color-paper-darker);
}

/* ========================================
   空状态
   ======================================== */

.bottom-space {
  height: var(--space-4xl);
}
