<!--分类页 - 性能优化+用户体验优化-->
<view class="page">
  <!-- 导航栏 -->
  <view class="navbar">
    <view class="navbar-left">
      <view class="navbar-back" bindtap="goBack" wx:if="{{selectedCategory}}">
        <text class="back-icon">‹</text>
      </view>
    </view>
    <text class="navbar-title">{{selectedCategory ? selectedCategory.name : '分类'}}</text>
    <view class="navbar-right"></view>
  </view>

  <!-- 内容区域 -->
  <scroll-view scroll-y class="content" enhanced enable-back-to-top>

    <!-- 分类列表 -->
    <view wx:if="{{!selectedCategory}}" class="fade-in">
      <!-- 引导提示 -->
      <view class="guide-tip">
        <text class="guide-icon">💡</text>
        <text class="guide-text">选择分类查看年代版别</text>
      </view>

      <view class="category-list card">
        <view
          class="category-item"
          wx:for="{{categories}}"
          wx:key="id"
          data-id="{{item.id}}"
          data-index="{{index}}"
          bindtap="selectCategory"
          hover-class="item-hover"
        >
          <view class="category-icon-wrap">
            <text class="category-icon">💰</text>
          </view>
          <view class="category-content">
            <text class="category-name">{{item.name}}</text>
            <text class="category-meta">{{item.eras.length}} 个年代</text>
          </view>
          <text class="category-arrow">›</text>
        </view>
      </view>

      <!-- 统计概览 -->
      <view class="stats-overview card">
        <view class="stats-row">
          <view class="stat-box">
            <text class="stat-value">{{categoryStats.totalCategories}}</text>
            <text class="stat-label">分类</text>
          </view>
          <view class="stat-divider"></view>
          <view class="stat-box">
            <text class="stat-value">{{categoryStats.totalEras}}</text>
            <text class="stat-label">年代</text>
          </view>
          <view class="stat-divider"></view>
          <view class="stat-box">
            <text class="stat-value">{{categoryStats.totalVariants}}</text>
            <text class="stat-label">版别</text>
          </view>
        </view>
      </view>
    </view>

    <!-- 年代列表 -->
    <view wx:elif="{{selectedCategory && !selectedEra}}" class="fade-in">
      <!-- 面包屑导航 -->
      <view class="breadcrumb">
        <text class="breadcrumb-item" bindtap="backToCategories">全部分类</text>
        <text class="breadcrumb-sep">›</text>
        <text class="breadcrumb-current">{{selectedCategory.name}}</text>
      </view>

      <view class="era-list card">
        <view
          class="era-item"
          wx:for="{{selectedCategory.eras}}"
          wx:key="id"
          data-era-id="{{item.id}}"
          data-era-name="{{item.name}}"
          data-years="{{item.years}}"
          bindtap="goToVariants"
          hover-class="item-hover"
        >
          <view class="era-content">
            <text class="era-name">{{item.name}}</text>
            <text class="era-years">{{item.years}}</text>
          </view>
          <view class="era-badge">
            <text>{{getEraVariantCount(item.id)}}</text>
          </view>
          <text class="era-arrow">›</text>
        </view>
      </view>
    </view>

    <!-- 版别列表 -->
    <view wx:else class="fade-in">
      <!-- 面包屑导航 -->
      <view class="breadcrumb">
        <text class="breadcrumb-item" bindtap="backToCategories">全部分类</text>
        <text class="breadcrumb-sep">›</text>
        <text class="breadcrumb-item" bindtap="backToEras">{{selectedEra.name}}</text>
        <text class="breadcrumb-sep">›</text>
        <text class="breadcrumb-current">版别</text>
      </view>

      <!-- 筛选栏 -->
      <view class="filter-bar">
        <view class="filter-group">
          <view
            class="filter-btn {{filterType === 'all' ? 'active' : ''}}"
            data-type="all"
            bindtap="filterVariants"
          >
            全部
          </view>
          <view
            class="filter-btn {{filterType === 'collected' ? 'active' : ''}}"
            data-type="collected"
            bindtap="filterVariants"
          >
            已收藏
          </view>
          <view
            class="filter-btn {{filterType === 'uncollected' ? 'active' : ''}}"
            data-type="uncollected"
            bindtap="filterVariants"
          >
            未收藏
          </view>
        </view>
        <text class="filter-count">{{filteredVariants.length}} 个版别</text>
      </view>

      <!-- 版别列表 -->
      <view class="variant-list" wx:if="{{filteredVariants.length > 0}}">
        <view
          class="variant-card card"
          wx:for="{{filteredVariants}}"
          wx:key="id"
        >
          <view class="variant-header">
            <text class="variant-name">{{item.name}}</text>
            <view class="variant-status {{item.collected ? 'collected' : ''}}">
              <text>{{item.collected ? '已收藏' : '未收藏'}}</text>
            </view>
          </view>

          <view class="sub-variants">
            <view
              class="sub-variant-item"
              wx:for="{{item.subVariants}}"
              wx:for-item="sub"
              wx:key="id"
              data-sub-id="{{sub.id}}"
              data-sub-name="{{sub.name}}"
              bindtap="selectSubVariant"
              hover-class="item-hover"
            >
              <view class="sub-variant-info">
                <text class="sub-variant-name">{{sub.name}}</text>
                <view class="sub-variant-badges">
                  <view class="badge {{sub.collected ? 'badge-success' : 'badge-default'}}">
                    <text>{{sub.collected ? '✓' : '○'}}</text>
                  </view>
                  <view class="badge badge-count" wx:if="{{sub.images && sub.images.length > 0}}">
                    <text>{{sub.images.length}}张</text>
                  </view>
                </view>
              </view>
              <view class="sub-variant-actions">
                <view
                  class="action-btn primary"
                  data-variant-id="{{sub.id}}"
                  data-variant-name="{{sub.name}}"
                  bindtap="goToUpload"
                >
                  {{sub.collected ? '+图片' : '收藏'}}
                </view>
                <view
                  class="action-btn secondary"
                  wx:if="{{sub.images && sub.images.length > 0}}"
                  data-images="{{sub.images}}"
                  bindtap="previewImages"
                >
                  查看
                </view>
              </view>
            </view>
          </view>
        </view>
      </view>

      <!-- 空状态 -->
      <view class="empty-state" wx:else>
        <text class="empty-icon">📭</text>
        <text class="empty-title">暂无版别</text>
        <text class="empty-text">该年代下没有版别数据</text>
      </view>
    </view>

    <!-- 底部留白 -->
    <view class="bottom-space"></view>
  </scroll-view>

  <!-- 自定义TabBar -->
  <custom-tabbar list="{{tabbarList}}" selected="{{selectedTabBar}}" />
</view>
