<!--收藏品列表页-->
<view class="page">
  <!-- 导航栏 -->
  <view class="navbar">
    <view class="navbar-left" bindtap="goBack">
      <text class="navbar-back">‹</text>
    </view>
    <text class="navbar-title">{{title}}</text>
    <view class="navbar-right"></view>
  </view>

  <!-- 内容区域 -->
  <scroll-view
    scroll-y
    class="content"
    refresher-enabled="{{scrollTop === 0}}"
    refresher-triggered="{{refreshing}}"
    bindrefresherrefresh="onRefresh"
    bindscroll="onScroll"
    scroll-top="{{scrollTop}}"
  >
    <!-- 收藏品网格 -->
    <view class="collection-grid" wx:if="{{collections.length > 0}}">
      <view
        class="collection-card"
        wx:for="{{collections}}"
        wx:key="_id"
        bindtap="viewDetail"
        data-id="{{item._id}}"
      >
        <view class="card-image-wrap">
          <image
            class="card-image"
            src="{{item.displayUrl}}"
            mode="aspectFill"
            wx:if="{{item.displayUrl}}"
          />
          <view class="image-placeholder" wx:else>
            <text>暂无图片</text>
          </view>
        </view>
        <view class="card-info">
          <text class="card-name">{{item.variantName || item.name}}</text>
          <text class="card-meta">{{item.eraName}}</text>
        </view>
      </view>
    </view>

    <!-- 空状态 -->
    <view class="empty-state" wx:if="{{collections.length === 0 && !loading}}">
      <text class="empty-icon">💰</text>
      <text class="empty-title">暂无收藏品</text>
      <text class="empty-text">该分类下还没有收藏品</text>
    </view>

    <!-- 加载状态 -->
    <view class="loading-state" wx:if="{{loading}}">
      <text>加载中...</text>
    </view>

    <!-- 底部留白 -->
    <view class="bottom-space"></view>
  </scroll-view>
</view>
