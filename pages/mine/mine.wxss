/**
 * 个人中心页面样式
 */
.container {
  padding: 0;
  background-color: #f5f5f5;
}

/* 用户头部 */
.user-header {
  margin: 20rpx;
  background: linear-gradient(135deg, #8B4513 0%, #A0522D 100%);
  color: #fff;
  display: flex;
  align-items: center;
  padding: 40rpx 32rpx;
}

.avatar {
  margin-right: 24rpx;
}

.avatar-icon {
  font-size: 100rpx;
}

.user-info {
  flex: 1;
}

.username {
  font-size: 40rpx;
  font-weight: bold;
  display: block;
  margin-bottom: 8rpx;
}

.user-desc {
  font-size: 26rpx;
  opacity: 0.9;
}

/* 统计卡片 */
.stats-card {
  margin: 20rpx;
}

.stats-row {
  display: flex;
  justify-content: space-around;
  align-items: center;
}

.stat-item {
  text-align: center;
  flex: 1;
}

.stat-value {
  font-size: 48rpx;
  font-weight: bold;
  color: #8B4513;
  display: block;
  margin-bottom: 8rpx;
}

.stat-label {
  font-size: 24rpx;
  color: #666;
}

.divider {
  width: 2rpx;
  height: 80rpx;
  background-color: #e0e0e0;
}

/* 收藏列表 */
.section-card {
  margin: 20rpx;
}

.section-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 20rpx;
}

.section-count {
  font-size: 26rpx;
  color: #999;
}

.collection-list {
  display: flex;
  flex-direction: column;
  gap: 16rpx;
}

.collection-item {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 20rpx;
  background-color: #f9f9f9;
  border-radius: 12rpx;
}

.collection-left {
  display: flex;
  align-items: center;
  flex: 1;
}

.collection-image {
  width: 120rpx;
  height: 120rpx;
  border-radius: 8rpx;
  margin-right: 16rpx;
  background-color: #f0f0f0;
}

.collection-info {
  flex: 1;
}

.collection-name {
  font-size: 28rpx;
  font-weight: bold;
  color: #333;
  display: block;
  margin-bottom: 8rpx;
}

.collection-date {
  font-size: 24rpx;
  color: #999;
  display: block;
  margin-bottom: 6rpx;
}

.collection-image-count {
  font-size: 24rpx;
  color: #8B4513;
}

.collection-actions {
  margin-left: 16rpx;
}

.action-btn {
  padding: 12rpx 24rpx;
  background-color: #ff4444;
  color: #fff;
  border-radius: 6rpx;
  font-size: 26rpx;
}

/* 空状态 */
.empty-state {
  text-align: center;
  padding: 80rpx 40rpx;
}

.empty-icon {
  font-size: 100rpx;
  display: block;
  margin-bottom: 20rpx;
}

.empty-text {
  font-size: 28rpx;
  color: #999;
}

/* 菜单列表 */
.menu-card {
  margin: 20rpx;
}

.menu-item {
  display: flex;
  align-items: center;
  padding: 24rpx 0;
  border-bottom: 2rpx solid #f0f0f0;
}

.menu-item:last-child {
  border-bottom: none;
}

.menu-item.danger .menu-text {
  color: #ff4444;
}

.menu-icon {
  font-size: 40rpx;
  margin-right: 20rpx;
}

.menu-text {
  flex: 1;
  font-size: 30rpx;
  color: #333;
}

.menu-arrow {
  font-size: 40rpx;
  color: #ccc;
}
