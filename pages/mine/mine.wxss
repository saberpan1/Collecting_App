/**
 * 个人中心样式 - 收藏展示版
 */

/* 页面容器 */
.page-container {
  min-height: 100vh;
  background-color: #fafaf8;
  display: flex;
  flex-direction: column;
}

/* 导航栏 */
.nav-bar {
  display: flex;
  align-items: center;
  justify-content: center;
  height: 88rpx;
  background-color: #ffffff;
  border-bottom: 1rpx solid #eeeeee;
}

.nav-title {
  font-size: 32rpx;
  font-weight: 600;
  color: #1a1a1a;
}

/* 搜索栏 */
.search-bar {
  padding: 16rpx 24rpx;
  background-color: #ffffff;
}

.search-input-wrap {
  display: flex;
  align-items: center;
  height: 72rpx;
  padding: 0 20rpx;
  background-color: #f5f5f3;
  border-radius: 36rpx;
}

.search-icon {
  font-size: 28rpx;
  margin-right: 12rpx;
}

.search-input {
  flex: 1;
  height: 72rpx;
  font-size: 28rpx;
  color: #1a1a1a;
}

.search-input::placeholder {
  color: #c7c7c7;
}

.search-clear {
  width: 44rpx;
  height: 44rpx;
  border-radius: 50%;
  background-color: #d1d1d1;
  display: flex;
  align-items: center;
  justify-content: center;
}

.search-clear text {
  font-size: 28rpx;
  color: #ffffff;
  font-weight: 300;
}

/* 搜索结果提示 */
.search-result-bar {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 12rpx 24rpx;
  background-color: rgba(201, 169, 98, 0.08);
}

.search-result-text {
  font-size: 24rpx;
  color: #c9a962;
}

.search-exit {
  padding: 8rpx 20rpx;
  background-color: #ffffff;
  border-radius: 20rpx;
}

.search-exit text {
  font-size: 22rpx;
  color: #c9a962;
  font-weight: 500;
}

/* 统计数据栏 */
.stats-bar {
  display: flex;
  justify-content: space-around;
  padding: 24rpx;
  background-color: #ffffff;
  border-bottom: 1rpx solid #f5f5f3;
}

.stats-bar .stat-item {
  text-align: center;
  flex: 1;
}

.stats-bar .stat-value {
  display: block;
  font-size: 36rpx;
  font-weight: 700;
  color: #c9a962;
  margin-bottom: 6rpx;
}

.stats-bar .stat-label {
  display: block;
  font-size: 20rpx;
  color: #999999;
}

.stats-bar .stat-divider {
  width: 1rpx;
  height: 60rpx;
  background-color: #eeeeee;
  align-self: center;
}

/* 滚动区域 */
.scroll-content {
  flex: 1;
  height: calc(100vh - 88rpx - 104rpx - 100rpx);
}

/* 区块 */
.section {
  padding: 24rpx;
}

.section-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 20rpx;
}

.section-title {
  font-size: 22rpx;
  font-weight: 600;
  color: #999999;
  text-transform: uppercase;
  letter-spacing: 1rpx;
}

.section-count {
  font-size: 24rpx;
  color: #c9a962;
  font-weight: 500;
}

/* 瀑布流网格 */
.collection-grid {
  display: flex;
  flex-wrap: wrap;
  justify-content: space-between;
  padding: 0 24rpx;
}

.collection-card {
  position: relative;
  width: 48%;
  margin-bottom: 16rpx;
  background-color: #ffffff;
  border-radius: 12rpx;
  overflow: hidden;
  box-shadow: 0 2rpx 8rpx rgba(0, 0, 0, 0.04);
}

.collection-card:active {
  transform: scale(0.98);
}

/* 图片容器 */
.card-image-wrap {
  position: relative;
  width: 100%;
  padding-bottom: 133%;
  background-color: #f5f5f3;
}

.card-image {
  position: absolute;
  top: 0;
  left: 0;
  width: 100%;
  height: 100%;
}

/* 搜索模式下卡片宽度100% */
.collection-card.search-mode {
  width: 100%;
  display: flex;
  flex-direction: row;
}

.collection-card.search-mode .card-image-wrap {
  width: 200rpx;
  height: 200rpx;
  flex-shrink: 0;
  aspect-ratio: auto;
}

.collection-card.search-mode .card-info {
  flex: 1;
  padding: 20rpx;
  display: flex;
  flex-direction: column;
  justify-content: center;
}

.image-placeholder {
  position: absolute;
  inset: 0;
  display: flex;
  align-items: center;
  justify-content: center;
  background-color: #f5f5f3;
}

.image-placeholder text {
  font-size: 64rpx;
  opacity: 0.2;
}

/* 图片数量 */
.image-count {
  position: absolute;
  top: 12rpx;
  right: 12rpx;
  padding: 6rpx 14rpx;
  background-color: rgba(0, 0, 0, 0.6);
  border-radius: 20rpx;
}

.image-count text {
  font-size: 20rpx;
  color: #ffffff;
  font-weight: 500;
}

/* 卡片信息 */
.card-info {
  padding: 16rpx;
}

.card-name {
  display: block;
  font-size: 28rpx;
  font-weight: 600;
  color: #1a1a1a;
  margin-bottom: 10rpx;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.card-meta {
  display: flex;
  justify-content: space-between;
  align-items: center;
}

.card-date {
  font-size: 22rpx;
  color: #999999;
}

.card-price {
  font-size: 24rpx;
  color: #c9a962;
  font-weight: 600;
}

/* 删除按钮 */
.card-delete {
  position: absolute;
  top: 12rpx;
  right: 12rpx;
  width: 48rpx;
  height: 48rpx;
  border-radius: 50%;
  background-color: rgba(255, 59, 48, 0.9);
  display: flex;
  align-items: center;
  justify-content: center;
  opacity: 0;
  transition: opacity 0.15s ease;
}

.collection-card:active .card-delete {
  opacity: 1;
}

.card-delete text {
  font-size: 32rpx;
  color: #ffffff;
  font-weight: 300;
}

/* 空状态 */
.empty-state {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 80rpx 48rpx;
  background-color: #ffffff;
  border-radius: 20rpx;
}

.empty-icon-wrap {
  width: 120rpx;
  height: 120rpx;
  border-radius: 50%;
  background-color: #fafaf8;
  display: flex;
  align-items: center;
  justify-content: center;
  margin-bottom: 32rpx;
}

.empty-icon {
  font-size: 64rpx;
}

.empty-title {
  font-size: 32rpx;
  font-weight: 600;
  color: #1a1a1a;
  margin-bottom: 12rpx;
}

.empty-desc {
  font-size: 26rpx;
  color: #999999;
  margin-bottom: 40rpx;
  text-align: center;
}

.btn-start {
  padding: 20rpx 48rpx;
  background-color: #c9a962;
  color: #ffffff;
  border-radius: 48rpx;
  font-size: 28rpx;
  font-weight: 600;
  border: none;
}

.btn-start:active {
  opacity: 0.8;
  transform: scale(0.98);
}

/* 底部留白 */
.bottom-space {
  height: 32rpx;
}