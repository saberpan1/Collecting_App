<!--个人中心页面-->
<view class="container">
  <!-- 用户信息头部 -->
  <view class="user-header card">
    <view class="avatar">
      <text class="avatar-icon">👤</text>
    </view>
    <view class="user-info">
      <text class="username">古钱币收藏家</text>
      <text class="user-desc">记录您的收藏历程</text>
    </view>
  </view>

  <!-- 统计卡片 -->
  <view class="stats-card card">
    <view class="stats-row">
      <view class="stat-item">
        <text class="stat-value">{{stats.totalCollected}}</text>
        <text class="stat-label">收藏版别</text>
      </view>
      <view class="divider"></view>
      <view class="stat-item">
        <text class="stat-value">{{stats.totalImages}}</text>
        <text class="stat-label">上传图片</text>
      </view>
      <view class="divider"></view>
      <view class="stat-item">
        <text class="stat-value">{{stats.totalCategories}}</text>
        <text class="stat-label">分类数量</text>
      </view>
    </view>
  </view>

  <!-- 我的收藏 -->
  <view class="section-card card">
    <view class="section-header">
      <text class="section-title">我的收藏</text>
      <text class="section-count">共 {{collection.length}} 个</text>
    </view>

    <view class="collection-list" wx:if="{{collection.length > 0}}">
      <view class="collection-item" wx:for="{{collection}}" wx:key="id">
        <view class="collection-left">
          <image 
            class="collection-image" 
            src="{{item.images[0] || '/images/placeholder.png'}}" 
            mode="aspectFill"
            data-images="{{item.images}}"
            bindtap="previewImage"
          />
          <view class="collection-info">
            <text class="collection-name">{{item.name}}</text>
            <text class="collection-date">{{item.date}}</text>
            <text class="collection-image-count">📷 {{item.images.length}} 张</text>
          </view>
        </view>
        <view class="collection-actions">
          <view 
            class="action-btn delete"
            data-id="{{item.id}}"
            bindtap="deleteCollection"
          >
            删除
          </view>
        </view>
      </view>
    </view>

    <view class="empty-state" wx:else>
      <text class="empty-icon">📭</text>
      <text class="empty-text">暂无收藏</text>
    </view>
  </view>

  <!-- 功能菜单 -->
  <view class="menu-card card">
    <view class="menu-item" bindtap="exportData">
      <text class="menu-icon">📤</text>
      <text class="menu-text">导出数据</text>
      <text class="menu-arrow">›</text>
    </view>
    <view class="menu-item" bindtap="showAbout">
      <text class="menu-icon">ℹ️</text>
      <text class="menu-text">关于</text>
      <text class="menu-arrow">›</text>
    </view>
    <view class="menu-item danger" bindtap="clearAllData">
      <text class="menu-icon">🗑️</text>
      <text class="menu-text">清空所有数据</text>
      <text class="menu-arrow">›</text>
    </view>
  </view>
</view>
