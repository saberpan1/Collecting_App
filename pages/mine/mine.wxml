<!--个人中心 - 收藏展示版-->
<view class="page-container">
  <!-- 导航栏 -->
  <view class="nav-bar">
    <text class="nav-title">我的收藏</text>
  </view>

  <!-- 搜索栏 -->
  <view class="search-bar">
    <view class="search-input-wrap">
      <text class="search-icon">🔍</text>
      <input
        class="search-input"
        placeholder="搜索钱币名称..."
        value="{{searchKeyword}}"
        bindinput="onSearchInput"
        bindconfirm="onSearchConfirm"
        confirm-type="search"
      />
      <view class="search-clear" wx:if="{{searchKeyword}}" bindtap="clearSearch">
        <text>×</text>
      </view>
    </view>
  </view>

  <!-- 搜索结果提示 -->
  <view class="search-result-bar" wx:if="{{isSearching}}">
    <text class="search-result-text">找到 {{searchResult.length}} 个相关结果</text>
    <view class="search-exit" bindtap="exitSearch">
      <text>退出搜索</text>
    </view>
  </view>

  <!-- 统计数据 -->
  <view class="stats-bar">
    <view class="stat-item">
      <text class="stat-value">{{stats.totalCollected}}</text>
      <text class="stat-label">收藏版别</text>
    </view>
    <view class="stat-divider"></view>
    <view class="stat-item">
      <text class="stat-value">{{stats.totalImages}}</text>
      <text class="stat-label">图片数量</text>
    </view>
    <view class="stat-divider"></view>
    <view class="stat-item">
      <text class="stat-value">¥{{stats.totalValue}}</text>
      <text class="stat-label">收藏总价</text>
    </view>
  </view>

  <!-- 下拉刷新 -->
  <scroll-view
    scroll-y
    class="scroll-content"
    refresher-enabled="{{scrollTop === 0}}"
    refresher-triggered="{{refreshing}}"
    bindrefresherrefresh="onRefresh"
    bindscroll="onScroll"
    scroll-top="{{scrollTop}}"
  >
    <!-- 收藏列表 -->
    <view class="section">
      <view class="section-header">
        <text class="section-title">{{isSearching ? '搜索结果' : '全部收藏'}}</text>
        <text class="section-count">{{displayList.length}} 个版别</text>
      </view>

      <!-- 瀑布流网格 -->
      <view class="collection-grid" wx:if="{{displayList.length > 0}}">
        <view
          class="collection-card {{isSearching ? 'search-mode' : ''}}"
          wx:for="{{displayList}}"
          wx:key="_id"
          data-id="{{item._id}}"
          bindtap="onCardTap"
        >
          <!-- 图片 -->
          <view class="card-image-wrap">
            <image
              class="card-image"
              src="{{item.displayUrl}}"
              mode="aspectFill"
              lazy-load
            />
            <view class="image-placeholder" wx:if="{{!item.displayUrl}}">
              <text>📷</text>
            </view>
            <!-- 图片数量 -->
            <view class="image-count" wx:if="{{item.images && item.images.length > 1}}">
              <text>{{item.images.length}}</text>
            </view>
          </view>

          <!-- 信息 -->
          <view class="card-info">
            <text class="card-name">{{item.name}}</text>
            <view class="card-meta">
              <text class="card-date">{{item.date}}</text>
              <text class="card-price" wx:if="{{item.price > 0}}">¥{{item.price}}</text>
            </view>
          </view>

          <!-- 删除按钮 -->
          <view
            class="card-delete"
            catchtap="deleteCollection"
            data-id="{{item._id}}"
          >
            <text>×</text>
          </view>
        </view>
      </view>

      <!-- 空状态 -->
      <view class="empty-state" wx:else>
        <view class="empty-icon-wrap">
          <text class="empty-icon">{{isSearching ? '🔍' : '📭'}}</text>
        </view>
        <text class="empty-title">{{isSearching ? '未找到相关收藏' : '暂无收藏记录'}}</text>
        <text class="empty-desc">{{isSearching ? '换个关键词试试吧' : '快去上传您的第一枚古钱币吧'}}</text>
        <button class="btn-start" wx:if="{{!isSearching}}" bindtap="goToUpload">
          <text>开始上传</text>
        </button>
      </view>
    </view>

    <!-- 底部留白 -->
    <view class="bottom-space"></view>
  </scroll-view>

  <!-- 自定义TabBar -->
  <custom-tabbar list="{{tabbarList}}" selected="{{selectedTabBar}}" />
</view>