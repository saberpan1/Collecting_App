/**
 * TabBar 组件样式 - 精致图标设计
 * 设计理念：Apple级极简美学 + 古钱币文化元素
 */

/* ========================================
   TabBar 容器基础样式
   ======================================== */

.tabbar {
  display: flex;
  justify-content: space-around;
  align-items: flex-end;
  height: calc(100rpx + env(safe-area-inset-bottom));
  padding: 0 20rpx;
  padding-bottom: env(safe-area-inset-bottom);
  background: linear-gradient(180deg, #ffffff 0%, #fafafa 100%);
  border-top: 1rpx solid rgba(0, 0, 0, 0.06);
  position: fixed;
  bottom: 0;
  left: 0;
  right: 0;
  z-index: 1000;
  backdrop-filter: blur(20px);
  -webkit-backdrop-filter: blur(20px);
}

/* ========================================
   TabBar 项
   ======================================== */

.tabbar-item {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: flex-end;
  padding: 12rpx 0 8rpx;
  transition: all 0.25s cubic-bezier(0.4, 0, 0.2, 1);
  cursor: pointer;
}

.tabbar-item:active {
  opacity: 0.6;
  transform: scale(0.94);
}

/* ========================================
   图标容器
   ======================================== */

.tabbar-icon-wrap {
  width: 56rpx;
  height: 56rpx;
  margin-bottom: 4rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  position: relative;
}

.icon-wrapper {
  width: 100%;
  height: 100%;
  display: flex;
  align-items: center;
  justify-content: center;
  transition: transform 0.3s cubic-bezier(0.34, 1.56, 0.64, 1);
}

.tabbar-icon-wrap.active .icon-wrapper {
  transform: scale(1.08);
}

/* ========================================
   图标通用样式
   ======================================== */

/* 首页图标 - 古钱币 */
.coin-icon {
  width: 44rpx;
  height: 44rpx;
  position: relative;
  display: flex;
  align-items: center;
  justify-content: center;
}

.coin-outer {
  position: absolute;
  width: 40rpx;
  height: 40rpx;
  border: 3rpx solid #c4c4c4;
  border-radius: 50%;
  transition: all 0.25s ease;
}

.coin-inner {
  position: absolute;
  width: 28rpx;
  height: 28rpx;
  border: 2rpx solid #c4c4c4;
  border-radius: 50%;
  transition: all 0.25s ease;
}

.coin-square {
  position: absolute;
  width: 14rpx;
  height: 14rpx;
  border: 2rpx solid #c4c4c4;
  border-radius: 3rpx;
  transform: rotate(45deg);
  transition: all 0.25s ease;
}

/* 选中态 */
.tabbar-icon-wrap.active .coin-outer,
.tabbar-icon-wrap.active .coin-inner,
.tabbar-icon-wrap.active .coin-square {
  border-color: #1a1a1a;
}

.tabbar-icon-wrap.active .coin-outer {
  box-shadow: 0 0 12rpx rgba(26, 26, 26, 0.15);
}

/* 分类图标 - 典籍书架 */
.book-icon {
  width: 40rpx;
  height: 40rpx;
  display: flex;
  align-items: flex-end;
  justify-content: center;
  gap: 4rpx;
  position: relative;
}

.book-spine {
  background: #c4c4c4;
  border-radius: 2rpx;
  transition: all 0.25s ease;
  position: relative;
}

.spine-1 {
  width: 6rpx;
  height: 32rpx;
}

.spine-2 {
  width: 6rpx;
  height: 26rpx;
}

.spine-3 {
  width: 6rpx;
  height: 36rpx;
}

/* 书脊装饰线 */
.book-spine::before {
  content: '';
  position: absolute;
  left: 50%;
  top: 50%;
  transform: translate(-50%, -50%);
  width: 3rpx;
  height: 60%;
  background: rgba(255, 255, 255, 0.4);
  border-radius: 1rpx;
  opacity: 0;
  transition: opacity 0.25s ease;
}

/* 选中态 */
.tabbar-icon-wrap.active .book-spine {
  background: #1a1a1a;
}

.tabbar-icon-wrap.active .book-spine::before {
  opacity: 1;
}

.tabbar-icon-wrap.active .spine-1 {
  height: 28rpx;
}

.tabbar-icon-wrap.active .spine-2 {
  height: 34rpx;
}

.tabbar-icon-wrap.active .spine-3 {
  height: 32rpx;
}

/* 统计图标 - 上升曲线 */
.chart-icon {
  width: 44rpx;
  height: 44rpx;
  position: relative;
  display: flex;
  align-items: center;
  justify-content: center;
}

.chart-line {
  position: absolute;
  background: #c4c4c4;
  border-radius: 2rpx;
  transition: all 0.25s ease;
}

.line-1 {
  width: 8rpx;
  height: 8rpx;
  left: 6rpx;
  bottom: 8rpx;
  opacity: 0.5;
}

.line-2 {
  width: 12rpx;
  height: 12rpx;
  left: 18rpx;
  bottom: 14rpx;
  opacity: 0.7;
}

.chart-dot {
  position: absolute;
  width: 10rpx;
  height: 10rpx;
  right: 6rpx;
  top: 10rpx;
  background: #c4c4c4;
  border-radius: 50%;
  transition: all 0.25s ease;
}

/* 连接线 */
.chart-line::after {
  content: '';
  position: absolute;
  background: #c4c4c4;
  height: 2rpx;
  transform-origin: left center;
  transition: all 0.25s ease;
}

.line-1::after {
  width: 10rpx;
  right: -10rpx;
  top: 50%;
  transform: rotate(-25deg);
}

.line-2::after {
  width: 10rpx;
  right: -10rpx;
  top: 50%;
  transform: rotate(30deg);
}

/* 选中态 */
.tabbar-icon-wrap.active .line-1,
.tabbar-icon-wrap.active .line-2,
.tabbar-icon-wrap.active .chart-dot {
  background: #1a1a1a;
}

.tabbar-icon-wrap.active .chart-dot {
  box-shadow: 0 0 8rpx rgba(26, 26, 26, 0.3);
}

.tabbar-icon-wrap.active .line-1 {
  opacity: 0.6;
  height: 10rpx;
}

.tabbar-icon-wrap.active .line-2 {
  opacity: 0.8;
  height: 16rpx;
}

.tabbar-icon-wrap.active .line-1::after,
.tabbar-icon-wrap.active .line-2::after {
  background: #1a1a1a;
}

/* 我的图标 - 印章 */
.seal-icon {
  width: 40rpx;
  height: 40rpx;
  position: relative;
  display: flex;
  align-items: center;
  justify-content: center;
}

.seal-outer {
  position: absolute;
  width: 36rpx;
  height: 36rpx;
  border: 3rpx solid #c4c4c4;
  border-radius: 6rpx;
  transform: rotate(45deg);
  transition: all 0.25s ease;
}

.seal-inner {
  position: absolute;
  width: 20rpx;
  height: 20rpx;
  border: 2rpx solid #c4c4c4;
  border-radius: 4rpx;
  transform: rotate(45deg);
  transition: all 0.25s ease;
}

/* 印章中心点 */
.seal-icon::before {
  content: '';
  position: absolute;
  width: 6rpx;
  height: 6rpx;
  background: #c4c4c4;
  border-radius: 50%;
  transition: all 0.25s ease;
  z-index: 1;
}

/* 选中态 */
.tabbar-icon-wrap.active .seal-outer,
.tabbar-icon-wrap.active .seal-inner,
.tabbar-icon-wrap.active .seal-icon::before {
  border-color: #1a1a1a;
  background: #1a1a1a;
}

.tabbar-icon-wrap.active .seal-outer {
  box-shadow: 0 0 10rpx rgba(26, 26, 26, 0.2);
}

/* ========================================
   文字样式
   ======================================== */

.tabbar-text {
  font-size: 20rpx;
  color: #b0b0b0;
  transition: all 0.25s cubic-bezier(0.4, 0, 0.2, 1);
  font-weight: 450;
  letter-spacing: 0.5rpx;
  margin-top: 2rpx;
}

.tabbar-text.active {
  color: #1a1a1a;
  font-weight: 550;
}

/* ========================================
   动画效果
   ======================================== */

@keyframes iconPop {
  0% {
    transform: scale(1);
  }
  40% {
    transform: scale(1.18);
  }
  70% {
    transform: scale(0.95);
  }
  100% {
    transform: scale(1.08);
  }
}

@keyframes rippleEffect {
  0% {
    box-shadow: 0 0 0 0 rgba(26, 26, 26, 0.15);
  }
  100% {
    box-shadow: 0 0 0 12rpx rgba(26, 26, 26, 0);
  }
}

.tabbar-icon-wrap.active .icon-wrapper {
  animation: iconPop 0.4s cubic-bezier(0.34, 1.56, 0.64, 1) forwards;
}

/* ========================================
   响应式适配 - 多设备兼容
   ======================================== */

/* 小屏幕设备 */
@media screen and (max-width: 320px) {
  .tabbar {
    height: 90rpx;
    padding-bottom: calc(env(safe-area-inset-bottom) * 0.8);
  }

  .tabbar-icon-wrap {
    width: 48rpx;
    height: 48rpx;
  }

  .tabbar-text {
    font-size: 18rpx;
  }

  .coin-outer {
    width: 36rpx;
    height: 36rpx;
  }

  .coin-inner {
    width: 24rpx;
    height: 24rpx;
  }

  .coin-square {
    width: 12rpx;
    height: 12rpx;
  }
}

/* 大屏幕设备 */
@media screen and (min-width: 414px) {
  .tabbar-icon-wrap {
    width: 60rpx;
    height: 60rpx;
  }

  .tabbar-text {
    font-size: 22rpx;
  }

  .coin-outer {
    width: 44rpx;
    height: 44rpx;
  }

  .coin-inner {
    width: 30rpx;
    height: 30rpx;
  }

  .coin-square {
    width: 16rpx;
    height: 16rpx;
  }
}

/* 平板设备 */
@media screen and (min-width: 768px) {
  .tabbar {
    max-width: 600px;
    left: 50%;
    transform: translateX(-50%);
    border-radius: 24rpx 24rpx 0 0;
  }

  .tabbar-item {
    padding: 16rpx 0 12rpx;
  }

  .tabbar-icon-wrap {
    width: 64rpx;
    height: 64rpx;
  }

  .tabbar-text {
    font-size: 24rpx;
  }
}

/* ========================================
   暗色模式支持
   ======================================== */

@media (prefers-color-scheme: dark) {
  .tabbar {
    background: linear-gradient(180deg, #1a1a1a 0%, #141414 100%);
    border-top-color: rgba(255, 255, 255, 0.08);
  }

  .tabbar-text {
    color: #666666;
  }

  .tabbar-text.active {
    color: #ffffff;
  }

  /* 暗色模式图标颜色 */
  .coin-outer,
  .coin-inner,
  .coin-square {
    border-color: #555555;
  }

  .book-spine {
    background: #555555;
  }

  .book-spine::before {
    background: rgba(0, 0, 0, 0.3);
  }

  .line-1,
  .line-2,
  .chart-dot {
    background: #555555;
  }

  .line-1::after,
  .line-2::after {
    background: #555555;
  }

  .seal-outer,
  .seal-inner {
    border-color: #555555;
    background: transparent;
  }

  .seal-icon::before {
    background: #555555;
  }

  /* 暗色模式选中态 */
  .tabbar-icon-wrap.active .coin-outer,
  .tabbar-icon-wrap.active .coin-inner,
  .tabbar-icon-wrap.active .coin-square {
    border-color: #ffffff;
  }

  .tabbar-icon-wrap.active .book-spine {
    background: #ffffff;
  }

  .tabbar-icon-wrap.active .line-1,
  .tabbar-icon-wrap.active .line-2,
  .tabbar-icon-wrap.active .chart-dot {
    background: #ffffff;
  }

  .tabbar-icon-wrap.active .line-1::after,
  .tabbar-icon-wrap.active .line-2::after {
    background: #ffffff;
  }

  .tabbar-icon-wrap.active .seal-outer,
  .tabbar-icon-wrap.active .seal-inner,
  .tabbar-icon-wrap.active .seal-icon::before {
    border-color: #ffffff;
    background: #ffffff;
  }
}

/* ========================================
   高对比度模式支持
   ======================================== */

@media (prefers-contrast: high) {
  .tabbar {
    border-top-width: 2rpx;
    border-top-color: #000000;
  }

  .tabbar-text {
    font-weight: 600;
  }

  .tabbar-text.active {
    font-weight: 700;
  }
}

/* ========================================
   减少动画模式支持
   ======================================== */

@media (prefers-reduced-motion: reduce) {
  .tabbar-item,
  .icon-wrapper,
  .tabbar-text,
  .coin-outer,
  .coin-inner,
  .coin-square,
  .book-spine,
  .chart-line,
  .chart-dot,
  .seal-outer,
  .seal-inner,
  .seal-icon::before {
    transition: none;
    animation: none;
  }

  .tabbar-icon-wrap.active .icon-wrapper {
    transform: scale(1.08);
  }
}